# Settings for `bun run prod`. Copy to `.env` (never commit it).
# `bun run dev` needs none of this.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it later invalidates every issued phone (HCE) credential.
CREDENTIAL_ENCRYPTION_KEY=

# Public address of Casdoor as browsers/phones reach it (token issuer).
OIDC_ISSUER=http://localhost:8000
# Client ids of the web and mobile applications created in Casdoor.
OIDC_AUDIENCES=field-day-web,field-day-mobile
# Web origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=
