# Copy to .env for local runs outside Docker (`make run`). Never commit .env.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text

DATABASE_URL=postgres://fieldday:fieldday@localhost:5432/fieldday?sslmode=disable
DATABASE_MAX_CONNS=10
MIGRATE_ON_START=true

# Casdoor (see docs/casdoor-setup.md). Audiences = client ids of web + mobile apps.
OIDC_ISSUER=http://localhost:8000
# Optional: fetch signing keys from here instead of discovery.
# OIDC_JWKS_URL=http://casdoor:8000/.well-known/jwks
OIDC_AUDIENCES=field-day-web,field-day-mobile
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_ROLE=admin

CORS_ALLOWED_ORIGINS=http://localhost:5173

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Changing it invalidates every issued phone (HCE) credential.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64
HCE_AID=F04649454C4444

SITE_TIMEZONE=Europe/Istanbul
UNLOCK_DURATION=3s
WALLET_CURRENCY=TRY

MQTT_ENABLED=true
MQTT_ADDR=:1883
# MQTT_TLS_CERT_FILE=/certs/mqtt.crt
# MQTT_TLS_KEY_FILE=/certs/mqtt.key

SHUTDOWN_TIMEOUT=15s
